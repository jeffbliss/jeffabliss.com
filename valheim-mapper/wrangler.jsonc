{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valheim-mapper",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "routes": [{ "pattern": "jeffabliss.com/valheim-mapper*", "zone_name": "jeffabliss.com" }],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "MAP", "class_name": "MapRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapRoom"] }],
  // ACCESS_TEAM / ACCESS_AUD are Worker *secrets* and must NOT appear here:
  // a `vars` entry of the same name replaces the remote secret on every deploy.
  "observability": { "enabled": true },
  // wrangler dev only: keep local request URLs on localhost so the DEV_IDENTITY guard in worker/access.js applies.
  "dev": { "host": "localhost", "port": 8787 }
}
